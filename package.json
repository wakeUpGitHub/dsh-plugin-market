{
  "name": "dsh-plugin-market",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH plugin market: browse/search installable bundles and ship a format-1 index validated by the official checker.",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "site/"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-app-boot": "*"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "plugin-market",
    "marketplace"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/fix-client-out.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "pack": "pnpm run build && pnpm pack"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
